{
  "openapi": "3.0.3",
  "info": {
    "title": "Orbit Finance API",
    "version": "1.0.0",
    "description": "Production REST API for Orbit - Personal Finance and Wealth Management System with multi-account support, atomic transfers, recurring subscriptions, rule-based smart insights, safe-to-spend budgeting, CSV batch import, and multi-factor security."
  },
  "servers": [
    {
      "url": "https://orbit-backend.onrender.com",
      "description": "Render Production Server"
    },
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "type": "object" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "currency": { "type": "string", "example": "INR" },
          "themePreference": { "type": "string", "enum": ["light", "dark", "system"] },
          "twoFactorEnabled": { "type": "boolean" }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "name": { "type": "string", "example": "HDFC Salary" },
          "bankName": { "type": "string", "example": "HDFC Bank" },
          "accountNumber": { "type": "string", "example": "4821" },
          "type": { "type": "string", "enum": ["bank", "card", "savings", "cash", "wallet", "loan", "liability", "other"] },
          "balance": { "type": "number", "example": 85000 },
          "initialBalance": { "type": "number", "example": 85000 },
          "color": { "type": "string", "example": "#004C8F" },
          "isDefault": { "type": "boolean" }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "type": { "type": "string", "enum": ["income", "expense", "transfer"] },
          "amount": { "type": "number", "example": 1450 },
          "account": { "type": "string" },
          "toAccount": { "type": "string" },
          "category": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "note": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "paymentMethod": { "type": "string", "enum": ["cash", "card", "UPI", "bank", "other"] }
        }
      },
      "Recurring": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "note": { "type": "string" },
          "amount": { "type": "number" },
          "frequency": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly"] },
          "category": { "type": "string" },
          "account": { "type": "string" },
          "nextRunDate": { "type": "string", "format": "date-time" },
          "isActive": { "type": "boolean" }
        }
      },
      "Budget": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "category": { "type": "string" },
          "monthlyLimit": { "type": "number" },
          "spent": { "type": "number" },
          "percentage": { "type": "number" },
          "isWarning": { "type": "boolean" },
          "isExceeded": { "type": "boolean" }
        }
      },
      "Goal": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "title": { "type": "string" },
          "targetAmount": { "type": "number" },
          "currentAmount": { "type": "number" },
          "suggestedMonthlyContribution": { "type": "number" },
          "targetDate": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "security": [
    { "bearerAuth": [] },
    { "cookieAuth": [] }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "API Health Check",
        "security": [],
        "responses": {
          "200": { "description": "Server is healthy" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register a new user account",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 6 },
                  "currency": { "type": "string", "default": "INR" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login user with credentials",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful or 2FA required" }
        }
      }
    },
    "/api/auth/login/2fa": {
      "post": {
        "summary": "Complete 2FA verification login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tempToken", "code"],
                "properties": {
                  "tempToken": { "type": "string" },
                  "code": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "2FA Login successful" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "summary": "Rotate refresh token & issue new access token",
        "security": [],
        "responses": {
          "200": { "description": "Tokens rotated" }
        }
      }
    },
    "/api/auth/demo": {
      "post": {
        "summary": "1-Click Demo Sandbox login with seeded accounts, transactions, and budgets",
        "security": [],
        "responses": {
          "200": { "description": "Demo session started" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "responses": {
          "200": { "description": "User profile" }
        }
      }
    },
    "/api/auth/audit-logs": {
      "get": {
        "summary": "Get security audit logs for the authenticated user",
        "responses": {
          "200": { "description": "List of recent security events" }
        }
      }
    },
    "/api/accounts": {
      "get": {
        "summary": "List all financial accounts and live balances",
        "responses": {
          "200": { "description": "Accounts array" }
        }
      },
      "post": {
        "summary": "Create a new bank account, card, wallet or liability",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Account" }
            }
          }
        },
        "responses": {
          "201": { "description": "Account created" }
        }
      }
    },
    "/api/transactions": {
      "get": {
        "summary": "List and filter transactions with server pagination, tags, search",
        "parameters": [
          { "name": "account", "in": "query", "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["income", "expense", "transfer"] } },
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "tag", "in": "query", "schema": { "type": "string" } },
          { "name": "minAmount", "in": "query", "schema": { "type": "number" } },
          { "name": "maxAmount", "in": "query", "schema": { "type": "number" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Paginated transactions" }
        }
      },
      "post": {
        "summary": "Record a new expense, income, or atomic transfer between accounts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Transaction" }
            }
          }
        },
        "responses": {
          "201": { "description": "Transaction logged and account balances updated atomically" }
        }
      }
    },
    "/api/recurring": {
      "get": {
        "summary": "List subscriptions & recurring transaction rules",
        "responses": {
          "200": { "description": "Recurring rules with total committed monthly spend" }
        }
      },
      "post": {
        "summary": "Create a recurring transaction rule",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Recurring" }
            }
          }
        },
        "responses": {
          "201": { "description": "Recurring rule created" }
        }
      }
    },
    "/api/budgets": {
      "get": {
        "summary": "Get category budgets, current spend progress, and safe-to-spend figure",
        "responses": {
          "200": { "description": "Budget progress & alert indicators" }
        }
      }
    },
    "/api/goals": {
      "get": {
        "summary": "List savings goals and suggested monthly savings",
        "responses": {
          "200": { "description": "Savings goals" }
        }
      }
    },
    "/api/analytics/trends": {
      "get": {
        "summary": "Get 6-month historical cashflow trajectory and net worth trend",
        "responses": {
          "200": { "description": "Historical trend arrays" }
        }
      }
    },
    "/api/analytics/insights": {
      "get": {
        "summary": "Get rule-based smart insights (MoM category spikes, weekday vs weekend spend)",
        "responses": {
          "200": { "description": "Smart financial insights" }
        }
      }
    },
    "/api/export/csv": {
      "get": {
        "summary": "Export transactions as sanitized CSV",
        "responses": {
          "200": { "description": "CSV stream attachment" }
        }
      }
    },
    "/api/export/import/preview": {
      "post": {
        "summary": "Preview CSV import data with auto-detected columns and duplicate hash detection",
        "responses": {
          "200": { "description": "Parsed rows preview and duplicate flags" }
        }
      }
    },
    "/api/export/import": {
      "post": {
        "summary": "Commit batch import transactions atomically",
        "responses": {
          "200": { "description": "Import result statistics" }
        }
      }
    }
  }
}
